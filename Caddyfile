# Caddy: la ÚNICA puerta de entrada. Todo lo demás vive en redes internas de Docker.
#   /api/*  → api (NestJS)
#   el resto → web (Next.js)
# Las cabeceras de seguridad se ponen AQUÍ, en un solo lugar, para todas las respuestas.
{
	admin off
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# La Content-Security-Policy ya NO se pone aquí (S-2): la genera web/src/proxy.ts con un nonce distinto por petición,
		# algo que una cabecera fija de Caddy no puede hacer. Caddy conserva el resto de cabeceras de seguridad.
		-Server
		-X-Powered-By
	}

	# Las respuestas de la API (sesiones, datos de la cuenta) nunca se guardan en cachés.
	header /api/* Cache-Control "no-store"
	# La API solo devuelve JSON y archivos: su CSP es «nada de nada» (OWASP REST Security). Si un navegador llegara a
	# pintar una respuesta suya como página, no ejecuta ni carga nada, y nadie puede meterla en un marco. La de las
	# páginas (con nonce) la pone web/src/proxy.ts; esta no se pisa con aquella porque cada una cubre sus rutas.
	header /api/* Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	# Páginas que reciben un token en la URL (enlaces de correo): el token no debe
	# salir en la cabecera Referer hacia ningún otro sitio (lección: rutas por token).
	# Dos condiciones que se excluyen: así no importa el orden en que Caddy las aplique.
	@token_pages path /verificar /restablecer /cancelar-2fa
	header @token_pages Referrer-Policy "no-referrer"
	@other_pages not path /verificar /restablecer /cancelar-2fa
	header @other_pages Referrer-Policy "strict-origin-when-cross-origin"

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
