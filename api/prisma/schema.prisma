// Schema de Atalaya. Convención: nombres en inglés y en plural en la base
// (`users`), en singular en el código (`User`). Las reglas que Prisma no sabe
// expresar (CHECK, filas fijas) viven como SQL dentro de cada migración.

generator client {
  provider     = "prisma-client"
  // Dentro de src/: Nest 12 exige que todo lo compilado viva bajo sourceRoot.
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Los 6 niveles de permiso (0 = usuario … 5 = super). Filas FIJAS: las siembra
/// la migración, no el código. `maxCount` = cuántas cuentas puede haber (null = sin límite).
model Role {
  id       Int    @id
  name     String @unique @db.VarChar(20)
  level    Int    @unique
  maxCount Int?   @map("max_count")
  users    User[]

  @@map("roles")
}

/// Una persona, una cuenta. Solo existe cuando su correo ya se verificó (ver EmailToken).
model User {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// Siempre en minúsculas (lo exige un CHECK en la base).
  email           String          @unique @db.VarChar(254)
  /// Argon2id. null mientras una invitación no se acepta (y en cuentas que solo entran con Google, v0.5).
  passwordHash    String?         @map("password_hash")
  emailVerifiedAt DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  roleId          Int             @map("role_id")
  role            Role            @relation(fields: [roleId], references: [id])
  /// Cuenta desactivada: no entra y sus sesiones dejan de servir al instante.
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  emailTokens     EmailToken[]
  twoFactor       TwoFactor?
  recoveryCodes   RecoveryCode[]
  oauthIdentities OAuthIdentity[]
  securityEvents  SecurityEvent[]
  auditAsActor    AuditLog[]      @relation("AuditActor")
  auditAsTarget   AuditLog[]      @relation("AuditTarget")
  uploads         Upload[]
  analyses        Analysis[]

  @@map("users")
}

/// Una sesión = un inicio de sesión en un dispositivo. Agrupa la "familia" de
/// refresh tokens que se van rotando. Se revisa en CADA petición: revocarla
/// corta el acceso al instante, aunque el token de acceso no haya vencido.
model Session {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Vida absoluta: pasada esta fecha hay que volver a escribir la contraseña.
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  /// logout | password_reset | reuse_detected | account_disabled | two_factor_changed (CHECK en la base).
  revokedReason String?        @map("revoked_reason") @db.VarChar(32)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Cada refresh token sirve UNA vez: al usarse se marca `rotatedAt` y nace otro.
/// Si vuelve a aparecer uno ya rotado, alguien lo robó (ver sessions.service.ts).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SHA-256 del token: la base nunca guarda el token mismo.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  register
  password_reset
  /// Cuenta creada por el admin: la persona elige su contraseña con este enlace (v0.3).
  invite

  @@map("email_token_purpose")
}

/// Enlaces de un solo uso enviados por correo. Un propósito por enlace: el de
/// registro no sirve para restablecer la contraseña, ni al revés.
model EmailToken {
  id           String            @id @default(uuid(7)) @db.Uuid
  purpose      EmailTokenPurpose
  email        String            @db.VarChar(254)
  /// En password_reset e invite (en registro el usuario todavía no existe).
  userId       String?           @map("user_id") @db.Uuid
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Solo en register: la contraseña elegida, ya en hash. Se copia al usuario al verificar.
  passwordHash String?           @map("password_hash")
  tokenHash    String            @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email])
  @@map("email_tokens")
}

enum MailStatus {
  pending
  sending
  sent
  failed

  @@map("mail_status")
}

/// Bandeja de salida (lección 226): quien quiere mandar un correo solo crea una
/// fila; un despachador la envía con reintentos. Así ninguna respuesta de la API
/// espera al servidor de correo (y no se puede medir por el tiempo si hubo envío).
model MailOutbox {
  id            String     @id @default(uuid(7)) @db.Uuid
  toAddress     String     @map("to_address") @db.VarChar(254)
  subject       String     @db.VarChar(200)
  /// Se vacían al enviarse: los enlaces con token no se quedan guardados.
  text          String
  html          String
  status        MailStatus @default(pending)
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime?  @map("locked_at") @db.Timestamptz(3)
  sentAt        DateTime?  @map("sent_at") @db.Timestamptz(3)
  /// Solo el código del error (p. ej. ECONNREFUSED), nunca el mensaje completo.
  lastError     String?    @map("last_error") @db.VarChar(64)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

/// El segundo factor (TOTP) de una cuenta. Nace "pendiente" (confirmedAt = null) al empezar a
/// activarlo y solo cuenta como activo cuando la persona demuestra que su app genera códigos.
model TwoFactor {
  userId       String    @id @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// El secreto TOTP, cifrado con AES-256-GCM (ver two-factor/secret-box.ts). Nunca en claro.
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Último paso de 30 s aceptado: un código ya usado no se acepta otra vez (RFC 6238 §5.2).
  lastUsedStep Int?      @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("two_factors")
}

/// Códigos de un solo uso para entrar si se pierde el teléfono. Se guarda solo su SHA-256.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("recovery_codes")
}

/// Una cuenta externa (hoy solo Google) enlazada a un usuario. Se identifica por `subject`
/// (el `sub` del proveedor, estable para siempre), NUNCA por el correo: el correo puede cambiar.
model OAuthIdentity {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @db.VarChar(20)
  subject   String   @db.VarChar(255)
  /// El correo que el proveedor tenía al enlazar (solo para auditar; no se usa para identificar).
  email     String   @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("oauth_identities")
}

/// Bitácora de seguridad: lo que un atacante (o un descuido) deja como rastro. Solo se escribe
/// desde security-log.service.ts, que además la topa y la poda. NUNCA guarda correos, contraseñas,
/// tokens ni la IP en claro: `ipHash` es un HMAC con llave del servidor (una IP son 32 bits: un
/// SHA-256 simple se invierte en minutos probando las 4 mil millones de direcciones).
model SecurityEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// login_failed | login_locked | two_factor_failed | refresh_reuse | google_rejected | rate_limited | csp_violation (CHECK en la base).
  type      String   @db.VarChar(32)
  /// La cuenta implicada, cuando se conoce. Si la cuenta se borra, el rastro se queda sin dueño.
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash    String?  @map("ip_hash") @db.Char(64)
  /// Un código corto (bad_password, token_nonce, /api/auth/login…), nunca datos de la persona.
  detail    String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

/// Auditoría: quién (un humano con sesión) hizo qué sobre qué cuenta. Distinta de la bitácora de
/// seguridad: aquí los hechos son legítimos, y lo que importa es poder reconstruirlos.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// user_created | role_changed | user_disabled | user_enabled | two_factor_enabled | two_factor_disabled | recovery_codes_regenerated (CHECK en la base).
  action    String   @db.VarChar(32)
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetId  String?  @map("target_id") @db.Uuid
  target    User?    @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)
  /// Un código corto (p. ej. el rol nuevo: «manager»).
  detail    String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Un archivo subido (CSV o XLSX) y el resultado de su revisión. Aquí viven solo METADATOS: los bytes están en
/// el volumen de subidas, bajo `storageKey`. El admin lista estos metadatos, nunca el contenido (decisión de arranque).
/// Las reglas de forma (tipos, estados, coherencia estado↔motivo↔fecha) las impone un CHECK en la base.
model Upload {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Si la cuenta se borra, sus archivos también (en cascada; el demo de v1.0 lo necesita).
  ownerId           String    @map("owner_id") @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// csv | xlsx. Sale de la FIRMA de los bytes, no de la extensión.
  kind              String    @db.VarChar(8)
  /// Nombre original saneado, solo para mostrárselo a su dueño. Nunca se usa como ruta.
  displayName       String?   @map("display_name") @db.VarChar(100)
  sizeBytes         Int       @map("size_bytes")
  /// SHA-256 en hex del contenido: el worker comprueba que lo que lee es lo que la API guardó.
  sha256            String    @db.Char(64)
  /// Nombre de archivo generado por el servidor (uuid v4 sin guiones); nunca viene del usuario.
  storageKey        String    @unique @map("storage_key") @db.Char(32)
  /// queued | checking | accepted | rejected
  status            String    @default("queued") @db.VarChar(16)
  /// Solo cuando status = rejected; lista cerrada (CHECK).
  rejectReason      String?   @map("reject_reason") @db.VarChar(24)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Cuándo terminó la revisión del worker (accepted o rejected).
  checkedAt         DateTime? @map("checked_at") @db.Timestamptz(3)
  /// Borrado pedido mientras el worker revisaba: el worker descarta su resultado y una poda quita la fila.
  deleteRequestedAt DateTime? @map("delete_requested_at") @db.Timestamptz(3)

  analyses Analysis[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("uploads")
}

/// El análisis de UN archivo ya aceptado, en dos pasos: vista previa → la persona confirma las columnas → limpieza e informe.
/// El worker escribe el estado, la vista previa y el informe (columnas con permiso propio); la API, todo lo demás.
/// Las reglas de forma (estados, motivo solo si falló, qué JSON existe en cada etapa) las impone un CHECK en la base.
model Analysis {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Si la cuenta o el archivo se borran, el análisis también (los archivos de resultados los retira la API).
  ownerId    String   @map("owner_id") @db.Uuid
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadId   String   @map("upload_id") @db.Uuid
  upload     Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  /// previewing | awaiting_mapping | queued | running | done | failed
  status     String   @default("previewing") @db.VarChar(16)
  /// Solo cuando status = failed; lista cerrada (CHECK).
  failReason String?  @map("fail_reason") @db.VarChar(24)
  /// Columnas, ejemplos y mapeo sugerido (lo escribe el worker). Dato hostil recortado: se muestra como texto.
  preview    Json?    @db.JsonB
  /// Lo que la persona confirmó (lo valida y escribe la API contra la vista previa).
  mapping    Json?    @db.JsonB
  /// El informe de calidad (lo escribe el worker, solo al terminar bien).
  report     Json?    @db.JsonB
  /// Nombre base (32 hex, lo genera la API) de los archivos de resultados: <llave>.clean.csv y <llave>.report.csv.
  resultKey  String   @unique @map("result_key") @db.Char(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// La API la mueve con @updatedAt; el worker la pone a mano (escribe con SQL, no con Prisma).
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@index([uploadId])
  @@index([status, createdAt])
  @@map("analyses")
}
