# Configuración NO secreta de producción. Cópialo como .env.prod (está en .gitignore; este archivo no lleva punto inicial porque el pre-commit veta cualquier .env.*).
# Las contraseñas y llaves NO van aquí: viven en secrets/ (créalas con ./scripts/crear-secretos.sh).

POSTGRES_USER=atalaya
POSTGRES_DB=atalaya
# El origen público del sitio, sin ruta ni barra final. Se compara tal cual contra la cabecera Origin.
APP_ORIGIN=https://atalaya.example.com
MAIL_FROM=Atalaya <no-reply@example.com>
# v1.0 · Demo de 24 h: encendida por omisión. DEMO_MODE=false = cuentas permanentes, sin límites de demo.
DEMO_MODE=true
DEMO_MAX_ACCOUNTS=50
# Puerto local de Caddy (solo 127.0.0.1).
ATALAYA_PORT=3070

# Login con Google de verdad (S-12). Todo o nada; el secreto del cliente va en secrets/oauth_client_secret.
# OAUTH_CLIENT_ID=…apps.googleusercontent.com
# OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OAUTH_ISSUER=https://accounts.google.com
