# Imagen de DESARROLLO del frontend (recarga en caliente). Producción: v1.0.
FROM node:24-alpine

RUN apk add --no-cache tini
WORKDIR /app
# La carpeta de trabajo es de "node": ahí escribe lo que genera (cliente de Prisma, dist/, .next/).
RUN chown node:node /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY --chown=node:node . .
# .next es un volumen aparte: se crea aquí con dueño "node" o Docker lo crea como root.
RUN mkdir -p .next && chown node:node .next
USER node
EXPOSE 3000

ENTRYPOINT ["tini", "--"]
CMD ["npm", "run", "dev"]
