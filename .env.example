# Copia este archivo como .env y CAMBIA todos los valores.
# NUNCA pongas aquí valores reales: este archivo se publica en el repo.
# Genera contraseñas con:  openssl rand -hex 24   (solo letras y números: van dentro de URLs)

POSTGRES_USER=atalaya
POSTGRES_DB=atalaya
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
REDIS_PASSWORD=cambia-esto-tambien
# El worker (v0.8) tiene su PROPIO usuario de Redis y su PROPIO rol de base, con permisos mínimos. Cada uno: openssl rand -hex 24
WORKER_REDIS_PASSWORD=cambia-esto-tambien-para-el-worker
WORKER_DB_PASSWORD=cambia-esto-tambien-para-la-base-del-worker
# Firma de las sesiones (JWT). Mínimo 32 caracteres:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios-de-openssl-rand-hex-32
# Llave que cifra los secretos del 2FA: EXACTAMENTE 64 hexadecimales:  openssl rand -hex 32
# Si la pierdes, nadie con 2FA podrá entrar con su app (queda el código de recuperación). Respáldala aparte de la base.
TOTP_ENCRYPTION_KEY=cambia-esto-por-64-hexadecimales-de-openssl-rand-hex-32

# Login con Google. En desarrollo y CI NO hace falta nada más: usa el servidor OAuth falso
# (carpeta mock-idp/) y este secreto compartido con él:  openssl rand -hex 24
OAUTH_CLIENT_SECRET=cambia-esto-por-un-secreto-del-servidor-oauth-falso
# Para entrar con Google DE VERDAD, crea un cliente OAuth en Google Cloud Console (URI de
# redirección: http://localhost:3070/api/auth/google/callback) y descomenta los seis:
# OAUTH_CLIENT_ID=…apps.googleusercontent.com
# OAUTH_CLIENT_SECRET=…
# OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OAUTH_ISSUER=https://accounts.google.com

# Puerto local del sitio (solo en 127.0.0.1): http://localhost:3070
ATALAYA_PORT=3070
# Bandeja de Mailpit (correos de desarrollo): http://localhost:3071
MAILPIT_PORT=3071
