# Copia este archivo como .env y CAMBIA todos los valores.
# NUNCA pongas aquí valores reales: este archivo se publica en el repo.
# Genera contraseñas con:  openssl rand -hex 24   (solo letras y números: van dentro de URLs)

POSTGRES_USER=atalaya
POSTGRES_DB=atalaya
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
REDIS_PASSWORD=cambia-esto-tambien
# Firma de las sesiones (JWT). Mínimo 32 caracteres:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios-de-openssl-rand-hex-32
# Llave que cifra los secretos del 2FA: EXACTAMENTE 64 hexadecimales:  openssl rand -hex 32
# Si la pierdes, nadie con 2FA podrá entrar con su app (queda el código de recuperación). Respáldala aparte de la base.
TOTP_ENCRYPTION_KEY=cambia-esto-por-64-hexadecimales-de-openssl-rand-hex-32

# Puerto local del sitio (solo en 127.0.0.1): http://localhost:3070
ATALAYA_PORT=3070
# Bandeja de Mailpit (correos de desarrollo): http://localhost:3071
MAILPIT_PORT=3071
