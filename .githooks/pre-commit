#!/usr/bin/env bash
# Pre-commit de Atalaya (repo PÚBLICO): nada sale de esta máquina con secretos o datos personales.
# Se activa una vez por clon:  git config core.hooksPath .githooks
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Ningún archivo .env real (solo .env.example, que lleva valores falsos).
if grep -E '(^|/)\.env($|\.)' <<<"$staged" | grep -vE '(^|/)\.env\.example$' ; then
  echo "✘ Bloqueado: hay un archivo .env en el commit."; exit 1
fi

# 2. Patrones privados: correos, nombres o dominios reales que NUNCA deben publicarse.
#    Viven en .git/private-patterns (una expresión por línea), FUERA del repo: si
#    estuvieran en el repo, publicarían justo lo que protegen.
patterns=.git/private-patterns
if [ -s "$patterns" ]; then
  if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -iEf "$patterns" >/dev/null; then
    echo "✘ Bloqueado: el commit contiene un dato de .git/private-patterns."; exit 1
  fi
fi

# 3. Secretos (llaves, tokens, contraseñas) con gitleaks.
GITLEAKS_VERSION=v8.30.1
if command -v gitleaks >/dev/null; then
  gitleaks git --pre-commit --staged --redact --no-banner .
elif command -v docker >/dev/null; then
  docker run --rm -v "$PWD:/repo" -w /repo "zricethezav/gitleaks:$GITLEAKS_VERSION" \
    git --pre-commit --staged --redact --no-banner /repo
else
  echo "✘ Bloqueado: no hay gitleaks ni Docker para revisar secretos."; exit 1
fi
